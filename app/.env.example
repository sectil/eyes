# RevenueCat herkese açık iOS SDK anahtarı (appl_ ile başlar). Gizli (secret) anahtarı KOYMA.
VITE_RC_IOS_KEY=
# Gizlilik politikası sayfasının adresi (App Store için zorunlu)
VITE_PRIVACY_URL=
# SADECE test derlemesi: 1 yapılırsa iPhone uygulaması abonelik kilidi olmadan açılır.
# App Store'a gönderilecek derlemede boş bırak.
VITE_TEST_UNLOCK=
# Supabase (hesap): herkese açık adres ve publishable anahtar. Boşsa lib/supabase.js'teki proje kullanılır.
# Gizli anahtar (sb_secret_ / service_role) ASLA buraya yazılmaz.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
