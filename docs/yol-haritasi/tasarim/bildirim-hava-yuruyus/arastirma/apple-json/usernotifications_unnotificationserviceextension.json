{"abstract":[{"text":"An object that modifies the content of a remote notification before it’s delivered to the user.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"c:objc(cs)UNNotificationServiceExtension","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UNNotificationServiceExtension"}],"modules":[{"name":"User Notifications"}],"navigatorTitle":[{"kind":"identifier","text":"UNNotificationServiceExtension"}],"platforms":[{"beta":false,"deprecated":false,"introducedAt":"10.0","name":"iOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"10.0","name":"iPadOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"13.1","name":"Mac Catalyst","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"10.14","name":"macOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"1.0","name":"visionOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"6.0","name":"watchOS","unavailable":false}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"UNNotificationServiceExtension"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst","macOS","visionOS","watchOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UNNotificationServiceExtension"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/modifying-content-in-newly-delivered-notifications"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension","isActive":true,"type":"reference"},{"text":" object provides the entry point for a notification service app extension. This object lets you customize the content of a remote notification before the system delivers it to the user. A notification service app extension doesn’t present any UI of its own. Instead, it’s launched on demand when the system delivers a notification of the appropriate type to the user’s device. You use this extension to modify the notification’s content or download content related to the extension. For example, you could use the extension to decrypt an encrypted data block or to download images associated with the notification.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You don’t create ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension","isActive":true,"type":"reference"},{"text":" objects yourself. Instead, the Xcode template for a notification service extension target contains a subclass for you to modify. Use the methods of that subclass to implement your app extension’s behavior. When your app receives a remote notification for your app, the system loads your extension and calls its ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension\/didReceive(_:withContentHandler:)","isActive":true,"type":"reference"},{"text":" method given the following conditions:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Your app has configured the remote notification to display an alert.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The remote notification’s ","type":"text"},{"code":"aps","type":"codeVoice"},{"text":" dictionary includes the ","type":"text"},{"code":"mutable-content","type":"codeVoice"},{"text":" key with the value set to ","type":"text"},{"code":"1","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"You can’t modify silent notifications or those that only play a sound or badge the app’s icon.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension\/didReceive(_:withContentHandler:)","isActive":true,"type":"reference"},{"text":" method performs the main work of your extension. You use that method to make any changes to the notification’s content. That method has a limited amount of time to perform its task and execute the provided completion block. If your method doesn’t finish in time, the system calls the ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension\/serviceExtensionTimeWillExpire()","isActive":true,"type":"reference"},{"text":" method to give you one last chance to submit your changes. If you don’t update the notification content before time expires, the system displays the original content.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As for any app extension, you deliver a notification service app extension class as a bundle inside your app. The template that Xcode provides configures the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" file automatically for this app extension type. Specifically, it sets the value of the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/library\/archive\/documentation\/General\/Reference\/InfoPlistKeyReference\/Articles\/AppExtensionKeys.html#\/\/apple_ref\/doc\/uid\/TP40014212-SW15","isActive":true,"type":"reference"},{"text":" key to ","type":"text"},{"code":"com.apple.usernotifications.service","type":"codeVoice"},{"text":" and sets the value of the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/library\/archive\/documentation\/General\/Reference\/InfoPlistKeyReference\/Articles\/AppExtensionKeys.html#\/\/apple_ref\/doc\/uid\/TP40014212-SW16","isActive":true,"type":"reference"},{"text":" key to the name of your ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension","isActive":true,"type":"reference"},{"text":" subclass.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For information about how to set up and send remote notifications, see ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/setting-up-a-remote-notification-server","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Subclassing-Notes","level":3,"text":"Subclassing Notes","type":"heading"},{"inlineContent":[{"text":"The Xcode templates provide a subclass of ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension","isActive":true,"type":"reference"},{"text":" for you to modify. You must implement the ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension\/didReceive(_:withContentHandler:)","isActive":true,"type":"reference"},{"text":" method and use it to process incoming notifications. It’s also strongly recommended that you override the ","type":"text"},{"identifier":"doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension\/serviceExtensionTimeWillExpire()","isActive":true,"type":"reference"},{"text":" method.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/ObjectiveC\/NSObject-swift.class"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/Swift\/CVarArg","doc:\/\/com.apple.documentation\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.documentation\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.documentation\/documentation\/Swift\/Equatable","doc:\/\/com.apple.documentation\/documentation\/Swift\/Hashable","doc:\/\/com.apple.documentation\/documentation\/ObjectiveC\/NSObjectProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Notification-service-app-extension","generated":true,"identifiers":["doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/modifying-content-in-newly-delivered-notifications"],"title":"Notification service app extension"}],"topicSections":[{"anchor":"Processing-Notifications","identifiers":["doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension\/didReceive(_:withContentHandler:)","doc:\/\/com.apple.usernotifications\/documentation\/UserNotifications\/UNNotificationServiceExtension\/serviceExtensionTimeWillExpire()"],"title":"Processing Notifications"}],"variants":[{"paths":["\/documentation\/usernotifications\/unnotificationserviceextension"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/usernotifications\/unnotificationserviceextension"],"traits":[{"interfaceLanguage":"occ"}]