{"abstract":[{"text":"Create prominent alerts at specified dates for your iOS app.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/scheduling-an-alarm-with-alarmkit"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"modules":[{"name":"AlarmKit"}],"platforms":[{"beta":false,"introducedAt":"26.0","name":"iOS"},{"beta":false,"introducedAt":"26.0","name":"iPadOS"},{"beta":false,"introducedAt":"26.0","name":"Mac Catalyst"},{"beta":false,"introducedAt":"26.0","name":"Xcode"}],"role":"sampleCode","roleHeading":"Sample Code","title":"Scheduling an alarm with AlarmKit"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"An alarm is an alert that presents at a pre-determined time based on a schedule or after a countdown.","type":"text"},{"text":" ","type":"text"},{"text":"It overrides both a device’s focus and silent mode, if necessary.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This sample project uses AlarmKit to create and manage different types of alarms.","type":"text"},{"text":" ","type":"text"},{"text":"In this app people can create and manage:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"One-time alarms","type":"text"}],"type":"strong"},{"text":" which alert only once at a specified time in the future.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Repeating alarms","type":"text"}],"type":"strong"},{"text":" which alert with a weekly cadence.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Timers","type":"text"}],"type":"strong"},{"text":" which alert after a countdown, and start immediately.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This project also includes a widget extension for setting up the custom countdown Live Activity associated with an alarm.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"This sample code project is associated with WWDC25 session 230: ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/wwdc25\/230","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Authorize-the-app-to-schedule-alarms","level":2,"text":"Authorize the app to schedule alarms","type":"heading"},{"inlineContent":[{"text":"This sample prompts people to authorize the app to allow AlarmKit to schedule alarms and create alerts by calling ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/requestAuthorization()","isActive":true,"type":"reference"},{"text":" on ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise, when a person adds their first alarm, AlarmKit automatically requests this authorization on behalf of the app, before scheduling the alarm.","type":"text"},{"text":" ","type":"text"},{"text":"If this sample doesn’t get this authorization, then any alarm created by the app isn’t scheduled and subsequently doesn’t alert.","type":"text"}],"type":"paragraph"},{"code":["do {","    let state = try await alarmManager.requestAuthorization()","    return state == .authorized","} catch {","    print(\"Error occurred while requesting authorization: \\(error)\")","    return false","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The sample includes the ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/BundleResources\/Information-Property-List\/NSAlarmKitUsageDescription","isActive":true,"type":"reference"},{"text":" key in the app’s ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" with a descriptive string explaining why it schedules alarms.","type":"text"},{"text":" ","type":"text"},{"text":"This string appears in the system prompt when requesting authorization, in this sample the string is:","type":"text"}],"type":"paragraph"},{"code":["We'll schedule alerts for alarms you create within our app."],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"If the ","type":"text"},{"code":"NSAlarmKitUsageDescription","type":"codeVoice"},{"text":" key is missing or its value is an empty string, apps can’t schedule alarms with AlarmKit.","type":"text"}],"type":"paragraph"},{"anchor":"Create-the-alarm-schedule","level":2,"text":"Create the alarm schedule","type":"heading"},{"inlineContent":[{"text":"The sample app creates an alarm with either, or both, a countdown duration and a schedule, based on the options a person sets.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm\/CountdownDuration-swift.struct","isActive":true,"type":"reference"},{"text":" uses the selected ","type":"text"},{"code":"TimeInterval","type":"codeVoice"},{"text":" for the  pre-alert countdown, which displays the alert when the countdown reaches 0.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm\/Schedule-swift.enum","isActive":true,"type":"reference"},{"text":" enables people to set a one-time alarm, or configure a weekly schedule.","type":"text"},{"text":" ","type":"text"},{"text":"For single-occurrence alarms, the ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm\/Schedule-swift.enum\/Relative\/repeats","isActive":true,"type":"reference"},{"text":" property is set to ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm\/Schedule-swift.enum\/Relative\/Recurrence\/never","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For recurring alarms, the ","type":"text"},{"code":"repeats","type":"codeVoice"},{"text":" property is set to ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm\/Schedule-swift.enum\/Relative\/Recurrence\/weekly(_:)","isActive":true,"type":"reference"},{"text":" with an associated array ","type":"text"},{"code":"Locale.Weekday","type":"codeVoice"},{"text":", indicating the days of the week the alarm alerts.","type":"text"}],"type":"paragraph"},{"code":["let time = Alarm.Schedule.Relative.Time(hour: hour, minute: minute)","return .relative(.init(","    time: time,","    repeats: weekdays.isEmpty ? .never : .weekly(Array(weekdays))","))"],"syntax":"swift","type":"codeListing"},{"anchor":"Configure-the-alarms-UI-attributes","level":2,"text":"Configure the alarm’s UI attributes","type":"heading"},{"inlineContent":[{"text":"AlarmKit provides a presentation for each of the three alarm states - ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Alert-swift.struct","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Countdown-swift.struct","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Paused-swift.struct","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"code":"Countdown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Paused","type":"codeVoice"},{"text":" are optional presentations, this sample doesn’t use them if the alarm only has an ","type":"text"},{"code":"Alert","type":"codeVoice"},{"text":" state.","type":"text"}],"type":"paragraph"},{"code":["let alertContent = AlarmPresentation.Alert(title: userInput.localizedLabel,","        stopButton: .stopButton,","        secondaryButton: secondaryButton,","        secondaryButtonBehavior: secondaryButtonBehavior)","","guard userInput.countdownDuration != nil else {","    \/\/ An alarm without countdown specifies only an alert state.","    return AlarmPresentation(alert: alertContent)","}","","\/\/ With countdown enabled, provide a presentation for both a countdown and paused state.","let countdownContent = AlarmPresentation.Countdown(title: userInput.localizedLabel,","        pauseButton: .pauseButton)","","let pausedContent = AlarmPresentation.Paused(title: \"Paused\",","        resumeButton: .resumeButton)","","return AlarmPresentation(alert: alertContent, countdown: countdownContent, paused: pausedContent)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Alongside the ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Alert-swift.struct\/stopButton","isActive":true,"type":"reference"},{"text":", the sample includes another action button in the alerting UI.","type":"text"},{"text":" ","type":"text"},{"text":"This action depends on ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Alert-swift.struct\/secondaryButton","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Alert-swift.struct\/secondaryButtonBehavior-swift.property","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["var secondaryButtonBehavior: AlarmPresentation.Alert.SecondaryButtonBehavior? {","    switch selectedSecondaryButton {","    case .none: nil","    case .countdown: .countdown","    case .openApp: .custom","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When the ","type":"text"},{"code":"secondaryButtonBehavior","type":"codeVoice"},{"text":" property is set to ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Alert-swift.struct\/SecondaryButtonBehavior-swift.enum\/countdown","isActive":true,"type":"reference"},{"text":", the secondary button is a ","type":"text"},{"code":"Repeat","type":"codeVoice"},{"text":" action, which re-triggers the alarm after a certain ","type":"text"},{"code":"TimeInterval","type":"codeVoice"},{"text":", as specified in ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm\/CountdownDuration-swift.struct\/postAlert","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If the ","type":"text"},{"code":"secondaryButtonBehavior","type":"codeVoice"},{"text":" is set to ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmPresentation\/Alert-swift.struct\/SecondaryButtonBehavior-swift.enum\/custom","isActive":true,"type":"reference"},{"text":", the alarm alert displays an ","type":"text"},{"code":"Open","type":"codeVoice"},{"text":" action to launch the app.","type":"text"}],"type":"paragraph"},{"code":["let secondaryButton: AlarmButton? = switch secondaryButtonBehavior {","    case .countdown: .repeatButton","    case .custom: .openAppButton","    default: nil","}"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"text":"The system forwards the alert presentation to a paired watch (if any) to notify people when an alarm is alerting.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"The content for these presentations is wrapped into ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/ActivityKit\/ActivityAttributes","isActive":true,"type":"reference"},{"text":", along with ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmAttributes\/tintColor","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmAttributes\/metadata","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The tint color associates the alarms with the sample app and also differentiates them from other app’s alarms on the person’s device.","type":"text"}],"type":"paragraph"},{"code":["let attributes = AlarmAttributes(presentation: alarmPresentation(with: userInput),","        metadata: CookingData(),","        tintColor: Color.blue)"],"syntax":"swift","type":"codeListing"},{"anchor":"Schedule-the-configured-alarm","level":2,"text":"Schedule the configured alarm","type":"heading"},{"inlineContent":[{"text":"The sample uses a unique identifier to track alarms registered with AlarmKit. The sample manages and updates alarm states, such as ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/pause(id:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/cancel(id:)","isActive":true,"type":"reference"},{"text":", using this identifier.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When a person taps the button in the alerting UI, the ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager","isActive":true,"type":"reference"},{"text":" automatically handles stop or countdown functionalities, depending on the button type.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"You can add additional actions for each button type using ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/AppIntents","isActive":true,"type":"reference"},{"text":", which you can configure using ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/AlarmConfiguration","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Tip","style":"tip","type":"aside"},{"code":["let id = UUID()","let alarmConfiguration = AlarmConfiguration(countdownDuration: userInput.countdownDuration,","        schedule: userInput.schedule,","        attributes: attributes,","        stopIntent: StopIntent(alarmID: id.uuidString),","        secondaryIntent: secondaryIntent(alarmID: id, userInput: userInput))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This sample creates the alarm ID and ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/AlarmConfiguration","isActive":true,"type":"reference"},{"text":" and schedules the alarm with ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let alarm = try await alarmManager.schedule(id: id, configuration: alarmConfiguration)"],"syntax":"swift","type":"codeListing"},{"anchor":"Observe-state-changes-on-the-alarms","level":2,"text":"Observe state changes on the alarms","type":"heading"},{"inlineContent":[{"text":"At initialization, the ","type":"text"},{"code":"ViewModel","type":"codeVoice"},{"text":" subscribes to alarm events from ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/shared","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This enables the sample app to have the latest state of an alarm even if the alarm state updated while the sample app isn’t running.","type":"text"}],"type":"paragraph"},{"code":["Task {","    for await incomingAlarms in alarmManager.alarmUpdates {","        updateAlarmState(with: incomingAlarms)","    }","}"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm","isActive":true,"type":"reference"},{"text":" that’s not included in the ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/alarmUpdates-swift.property","isActive":true,"type":"reference"},{"text":" asynchronous stream is no longer scheduled with AlarmKit.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Create-a-Widget-Extension-for-Live-Activities","level":2,"text":"Create a Widget Extension for Live Activities","type":"heading"},{"inlineContent":[{"text":"The sample app adds a widget extension target to customize non-alerting presentations in the Dynamic Island, Lock Screen, and StandBy.","type":"text"},{"text":" ","type":"text"},{"text":"The widget extension receives the same ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmAttributes","isActive":true,"type":"reference"},{"text":" structure that you provide to ","type":"text"},{"identifier":"doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager\/shared","isActive":true,"type":"reference"},{"text":" when scheduling alarms.","type":"text"},{"text":" ","type":"text"},{"text":"It includes the metadata provided in the ","type":"text"},{"identifier":"#Configure-the-alarms-UI-attributes","isActive":true,"type":"reference"},{"text":" section above.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"AlarmKit expects a widget extension if an app supports a countdown presentation.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise, the system may unexpectedly dismiss alarms and fail to alert.","type":"text"},{"text":" ","type":"text"},{"text":"For more information, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/ActivityKit","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"}],"kind":"content"}],"sampleCodeDownload":{"action":{"identifier":"c2045ce0bff8\/SchedulingAnAlarmWithAlarmKit.zip","isActive":true,"overridingTitle":"Download","type":"reference"},"kind":"sampleDownload"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Alarm-management","generated":true,"identifiers":["doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/AlarmManager","doc:\/\/com.apple.alarmkit\/documentation\/AlarmKit\/Alarm"],"title":"Alarm management"}],"variants":[{"paths":["\/documentation\/alarmkit\/scheduling-an-alarm-with-alarmkit"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"#Configure-the-alarms-UI-attributes":{"identifier":"#Configure-the-alarms-UI-attributes","title":"Configure the alarm’s UI attributes","titleInlineContent":[{"text":"Configure the alarm’s UI attributes","type":"text"}],"type":"link","url":"#Configure-the-alarms-UI-attributes"},"ActivityKit-PageImage-card.png":{"alt":"[A hero image of the ActivityKit framework.]","identifier":"ActivityKit-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.activitykit\/ActivityKit-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.activitykit\/ActivityKit-PageImage-card~dark@2x.png"}]},"c2045ce0bff8/SchedulingAnAlarmWithAlarmKit.zip":{"checksum":null,"identifier":"c2045ce0bff8\/SchedulingAnAlarmWithAlarmKit.zip","type":"download","url":"c2045ce0bff8\/SchedulingAnAlarmWithAlarmKit.zip"},"doc://com.apple.alarmkit/documentation/AlarmKit":{"abstract":[{"text":"Schedule prominent alarms and countdown