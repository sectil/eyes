+// Bölüm başlığı (7 günde bir): numarası, günleri ve o bölümde ilk kez gelecek duraklar (en çok dört)
+function ChapterHead({ c, news = [], icons }) {
+  return (
+    <div className="lp-ch" data-h={(c - 1) % 4}>
+      <span className="lp-ch-t"><b>{c}. bölüm</b><span>{(c - 1) * CHAPTER_DAYS + 1}.–{c * CHAPTER_DAYS}. gün</span></span>
+      {news.length > 0 && (
+        <span className="lp-ch-new">
+          <i className="hh-new">Yeni</i>
