+  background: var(--ok); color: #ffffff; font: 700 0.95rem/1 var(--font-body); }
+.pp-c { display: grid; gap: 12px; padding: 14px 14px 12px; border-radius: 22px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); }
+.pp-c.cur { box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 45%, transparent); border-color: transparent; }
+.pp-h { display: flex; align-items: center; gap: 10px; }
+.pp-h .pp-m { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); box-shadow: 0 0 0 3px var(--ok); }
+.pp-c.cur .pp-h .pp-m { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 40%, transparent); opacity: 0.7; }
+.pp-h b { font: 750 1.08rem/1.1 var(--font-display); color: var(--ink); }
