+  return (
+    <>
+      <defs>
+        <clipPath id={`ha-clip-${id}`}>
+          <path d={almond} />
+        </clipPath>
+        <radialGradient id={`ha-iris-${id}`} cx="0.4" cy="0.36" r="0.75">
+          <stop offset="0" stopColor="#5edce6" />
+          <stop offset="0.5" stopColor="#19c2d1" />
+          <stop offset="1" stopColor="#1f5fd6" />
+        </radialGradient>
+      </defs>
+      <path className="ha-sclera" d={almond} />
