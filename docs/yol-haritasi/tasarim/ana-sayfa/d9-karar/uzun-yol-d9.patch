+  background: color-mix(in srgb, var(--ch) 14%, var(--bg)); box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--ch) 50%, transparent); }
+.lp-rw-m { width: 64px; height: 64px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--surface); color: var(--lens);
+  box-shadow: 0 0 0 4px color-mix(in srgb, var(--ch) 70%, transparent), 0 8px 22px -8px var(--ch); }
+.lp-rw-t { display: grid; gap: 3px; }
