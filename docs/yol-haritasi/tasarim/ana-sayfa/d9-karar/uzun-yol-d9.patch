+:root[data-theme='dark'] .hh-chips .hh-fact.sky { --wx-rain: #6f9bff; }
+
+/* Sahnenin kahramanı yukarıda toplanır; kalan pay sahnenin dibinde (Home.jsx fit: yol yukarı çıkar) */
+.hf .hf-hero { flex: none; }
+
