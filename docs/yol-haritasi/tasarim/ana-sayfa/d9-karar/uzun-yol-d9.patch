+.hl-s.mile { display: inline-flex; text-align: left; text-wrap: pretty; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 999px; font-weight: 700; color: var(--lens-text);
+  background: color-mix(in srgb, var(--lens) 16%, var(--bg)); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--lens) 45%, transparent); }
+.hl-s.mile svg { flex: none; color: var(--lens); }
