+/* Etiketin zemini: yol çizgisi yazının ardından geçmesin */
+.lp-lb { padding: 3px 7px; border-radius: 12px; background: color-mix(in srgb, var(--bg) 88%, transparent); }
+/* Geçmiş en az bir ekran boyu (sekme çubuğu hariç), kartlar dipte: yukarı kaydırınca ekran yalnız geçmişi gösterir, selam
+   sekme çubuğunun kenarında yarım kalmaz */
+.pp { min-height: calc(100svh - 72px - env(safe-area-inset-bottom)); align-content: end; }
+/* Geçmişin çizgisi yalnız kartların arasında (sayfanın boş tepesine ve ilk görünümün üst payına uzanmaz) */
+.pp::before { display: none; }
+.pp > * + *::after { content: ''; position: absolute; left: 50%; top: -15px; height: 16px; width: 9px; margin-left: -4.5px; z-index: -1;
+  background: color-mix(in srgb, var(--ok) 40%, transparent); }
