+          let y = 0
+          const pts = [[50, 0]]
+          for (const r of p.rows) {
+            pts.push([r.x, y + r.h / 2])
+            y += r.h
+          }
+          pts.push([50, y])
+          let d = `M50 0`
+          for (let k = 1; k < pts.length; k++) {
+            const [x0, y0] = pts[k - 1]
+            const [x1, y1] = pts[k]
+            const my = (y0 + y1) / 2
+            d += ` C${x0} ${my} ${x1} ${my} ${x1} ${y1}`
+          }
+          return (
+            <div key={p.rows[0].key} className={`lp-run ${p.tone}`} style={{ height: y }}>
+              <svg className="lp-line" viewBox={`0 0 100 ${y}`} preserveAspectRatio="none" aria-hidden="true">
+                <path d={d} vectorEffect="non-scaling-stroke" />
+              </svg>
+              {p.rows.map((r) => (
+                <div key={r.key} className={`lp-r node ${r.tone}`} style={{ height: r.h }} data-h={r.h2}>{r.el(r)}</div>
+              ))}
+            </div>
+          )
+        }
+        return (
+          <div key={p.key} className={`lp-r c ${p.tone} ${p.extra ?? ''}`} style={p.h ? { height: p.h } : undefined}>
+            {p.el}
+          </div>
+        )
+      })}
+      <div ref={endRef} className="lp-end" aria-hidden="true" />
+    </section>
+  )
+}
diff -ruN /tmp/claude-0/-home-user/f143c393-27b3-538e-ba8a-5352290c6308/scratchpad/headsrc/app/src/components/home/PastPath.jsx app/src/components/home/PastPath.jsx
--- /tmp/claude-0/-home-user/f143c393-27b3-538e-ba8a-5352290c6308/scratchpad/headsrc/app/src/components/home/PastPath.jsx	1970-01-01 00:00:00.000000000 +0000
