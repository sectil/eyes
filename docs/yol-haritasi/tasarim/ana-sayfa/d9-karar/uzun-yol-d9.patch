+.hf.wk1 { min-height: 0; padding-bottom: 0; }
+.hf.wk1 .hf-hero { flex: none; }
+
+/* Büyük düğme, ad cümlede: durağın çizimi ve "Başla" */
+.hg.bare { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'art go'; gap: 10px; padding: 10px; border-radius: 26px; }
+.hg.bare .hg-art { display: grid; width: 58px; height: 58px; }
+.hg-go { grid-area: go; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 58px; border-radius: 18px;
+  font: 800 1.22rem/1 var(--font-body); letter-spacing: 0.01em; color: var(--go-cta-ink); background: var(--go-cta); }
