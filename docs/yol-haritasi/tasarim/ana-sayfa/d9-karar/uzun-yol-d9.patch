+    const c = chapterOf(n)
+    out.push({ key: `rw${n}`, c, title: `${c}. bölüm tamam`, small: c === 1 ? 'Gözün açılır' : n === 28 ? 'İris haritan yeniden' : null, done })
+  }
+  if (n === 30) out.push({ key: `mo${n}`, c: chapterOf(n), title: 'İlk ay tamam', small: '30. gün', month: true, done })
