@@ -0,0 +1,58 @@
+import { Check } from 'lucide-react'
+import { chapterOf, CHAPTER_DAYS } from '../../lib/pathAhead.js'
+import { IrisMark } from '../ui.jsx'
+
+// Ana sayfa · geçmiş (sahibin isteği 2026-10-01, D9: "geçmiş günler yolun üstünde yukarı doğru tamamlanmış görünsün,
+// bugün odakta"). Ana sayfanın en üstünde, selamın ÜSTÜNDE durur; Ana sayfa açılınca selama kayar (Home.jsx), kişi yukarı
+// kaydırınca görür.
+// Tur 2 (değerlendiriciler: "aynı hapın sekiz kez tekrarı, muhasebe dökümü", "sağdaki noktalar ne?", "bölüm bitişi ödül
+// gibi değil"): gün başına satır yerine bölüm başına kart. Kartta bölümün madalyası, adı, günleri ve "tamam"; altında
+// yedi gün halkası (biten gün tikli, bugün halkalı, gelecek gün soluk). Eskiden yeniye; en çok son dört bölüm, daha
+// eskiler tek hapta ("1.–6. bölüm tamam"). Nokta yok.
+//   days: lib/pathAhead.js pastDays sonucu; n: bugün yolun kaçıncı günü
+const MAX_CHAPTERS = 4
+
+export default function PastPath({ days = [], n = null }) {
+  if (!days.length) return null
+  const lastN = days.at(-1).n
+  const todayN = n ?? lastN + 1
+  const curC = chapterOf(todayN)
+  const fromC = Math.max(1, curC - MAX_CHAPTERS + 1)
+  const doneN = new Set(days.map((d) => d.n))
+  const cards = []
+  for (let c = fromC; c <= curC; c++) cards.push(c)
+  return (
+    <section className="pp" aria-label="Geçmiş günler">
+      {fromC > 1 && (
+        <span className="pp-sum"><Check size={16} strokeWidth={3} aria-hidden="true" />{fromC > 2 ? `1.–${fromC - 1}. bölüm tamam` : '1. bölüm tamam'}</span>
+      )}
+      {cards.map((c) => {
+        const first = (c - 1) * CHAPTER_DAYS + 1
+        const last = c * CHAPTER_DAYS
+        const complete = last < todayN
+        const items = Array.from({ length: CHAPTER_DAYS }, (_, i) => first + i)
+        const doneCount = items.filter((d) => doneN.has(d)).length
+        return (
+          <div key={c} className={`pp-c${complete ? '' : ' cur'}`} aria-label={`${c}. bölüm, ${first}.–${last}. gün, ${complete ? 'tamam' : `${doneCount} gün tamam`}`} role="group">
+            <div className="pp-h" aria-hidden="true">
+              <span className="pp-m"><IrisMark size={28} /></span>
+              <span className="pp-tx"><b>{c}. bölüm</b><small>{first}.–{last}. gün</small></span>
+              {complete && <span className="pp-ok"><Check size={16} strokeWidth={3} aria-hidden="true" />tamam</span>}
+            </div>
+            <ol className="pp-row" aria-hidden="true">
+              {items.map((d) => {
+                const st = d === todayN ? 'now' : doneN.has(d) || d < todayN ? 'done' : 'next'
+                return (
+                  <li key={d} className={`pp-d ${st}`}>
+                    <i>{st === 'done' ? <Check size={16} strokeWidth={3} aria-hidden="true" /> : d}</i>
+                    <small>{st === 'now' ? 'bugün' : st === 'done' ? `${d}` : '\u00a0'}</small>
+                  </li>
+                )
+              })}
+            </ol>
+          </div>
+        )
+      })}
+    </section>
+  )
+}
