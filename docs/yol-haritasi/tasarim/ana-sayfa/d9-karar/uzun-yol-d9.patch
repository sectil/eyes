+.pp-row { list-style: none; margin: 0; padding: 0; display: flex; justify-content: space-between; }
+.pp-d { display: grid; justify-items: center; gap: 4px; width: 36px; }
+.pp-d i { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font: 700 0.8rem/1 var(--font-body); font-style: normal;
+  background: var(--ok); color: #ffffff; }
+.pp-d.next i { background: var(--surface-2); color: var(--ink-3); }
+.pp-d.now i { background: var(--surface); color: var(--accent); box-shadow: inset 0 0 0 3px var(--accent); }
+.pp-d small { font: 600 0.74rem/1 var(--font-body); color: var(--ink-3); white-space: nowrap; }
+.pp-d.now small { color: var(--accent); font-weight: 700; }
+
+/* İlk 7 gün: bölümün yedi günü */
+.cs { display: grid; justify-items: center; gap: 10px; width: 100%; }
+.cs-h { font: 750 1rem/1 var(--font-display); color: var(--accent); letter-spacing: 0.01em; }
+.cs-row { position: relative; list-style: none; margin: 0; padding: 0; width: 100%; display: flex; justify-content: space-between; align-items: flex-start; }
+.cs-row::before { content: ''; position: absolute; left: 20px; right: 20px; top: 20px; height: 3px; margin-top: -1.5px; border-radius: 2px; background: var(--surface-3); }
+.cs-d { position: relative; z-index: 1; display: grid; justify-items: center; gap: 5px; width: 40px; }
+.cs-c { width: 34px; height: 34px; margin-top: 3px; border-radius: 50%; display: grid; place-items: center; background: var(--bg);
+  box-shadow: inset 0 0 0 2px var(--ink-3); }
+/* gelecek gün: dolu, açık renk (kesik çizgi "yükleniyor" gibi okundu; tur 2) */
+.cs-d.next .cs-c { background: color-mix(in srgb, var(--accent) 10%, var(--surface)); box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 30%, transparent); }
