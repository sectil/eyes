+  if (alt) rows.push({ key: 'alt', kind: 'c', tone: 'today', h: H.bandToday, extra: 'band', el: <Band band="nefes" tone="today" tap={alt.onTap} title={alt.title} sub={alt.sub} play aria={`${alt.title}, ${alt.sub}`} /> })
