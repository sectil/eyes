+.lp-rw-t small { font: 600 0.88rem/1.2 var(--font-body); color: var(--ink-2); }
+
+.lp-nef { width: 100%; padding: 14px 16px; border-radius: 20px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); }
