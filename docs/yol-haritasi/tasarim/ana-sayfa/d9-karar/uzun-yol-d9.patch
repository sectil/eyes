+  return (
+    <div className={`lp-rw${done ? ' done' : ''}`} data-h={(c - 1) % 4}>
+      <span className="lp-rw-m" aria-hidden="true">{month ? <Trophy size={28} strokeWidth={2.2} aria-hidden="true" /> : <IrisMark size={44} />}</span>
