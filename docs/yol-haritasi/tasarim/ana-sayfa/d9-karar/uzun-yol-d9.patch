+.cs-d.now .cs-c { width: 40px; height: 40px; margin-top: 0; background: var(--surface); box-shadow: inset 0 0 0 3px var(--accent), 0 0 0 4px var(--accent-soft); }
+.cs-d.now .cs-c b { color: var(--accent); font-size: 1rem; font-weight: 800; }
+.cs-d.rw .cs-c { background: color-mix(in srgb, var(--lens) 16%, var(--surface)); box-shadow: inset 0 0 0 2px var(--lens); }
+.cs-d small { font: 700 0.78rem/1 var(--font-body); color: var(--accent); white-space: nowrap; }
+
+/* Hap satırında hava (dokunulur, 44 pt) */
+.hh-chips .hh-fact.sky { --wx-rain: #2f6bea; min-height: 44px; padding: 0 8px 0 12px; gap: 7px; cursor: pointer; font: 650 0.9rem/1.2 var(--font-body); color: var(--ink); }
