+    if (band) {
+      rows.push({ key: s.key, kind: 'c', tone: 'today', h: H.bandToday, extra: 'band', el: <><Band band={band} s={s} tone="today" tap={tap} state={state} newOn={newOn} note={note} aria={aria} restMin={restMin} />{bubble}</> })
