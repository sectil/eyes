+
+export default function LongPath({ plan, today = [], newKeys = [], icons = {}, eye = null, onStart, dalga = true, n = 1, ahead = [], nef = null, nefTop = false, alarm = null, remind = false, onRemind, alt = null, chapter = false, restMin = null }) {
