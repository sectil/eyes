+/* Ödül günü durağı: madalya */
+.lp-n.day.prize { color: var(--lens); background: var(--surface); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ch, var(--lens)) 70%, transparent), 0 8px 20px -8px var(--ch, var(--lens)), 0 4px 0 var(--surface-3); }
+.lp-prize { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font: 700 0.8rem/1.2 var(--font-body);
