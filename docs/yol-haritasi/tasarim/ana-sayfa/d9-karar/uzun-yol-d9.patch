+  gr.addColorStop(1, 'rgba(255,255,255,0)')
+  g.fillStyle = gr
+  g.beginPath()
+  g.ellipse(0, 0, pr * 0.18, pr * 0.1, 0, 0, TAU)
+  g.fill()
+  g.restore()
+}
