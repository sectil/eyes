+  gr.addColorStop(1, 'rgba(2,6,10,0)')
+  g.fillStyle = gr
+  g.beginPath()
+  g.arc(0, 0, pr * 1.14, 0, TAU)
+  g.fill()
+  g.fillStyle = '#02060a'
+  g.beginPath()
+  g.arc(0, 0, pr, 0, TAU)
+  g.fill()
+  g.save()
+  g.translate(-pr * 0.6, -pr * 0.62)
