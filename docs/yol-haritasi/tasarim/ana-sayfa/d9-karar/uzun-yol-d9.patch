+.lp-nef p b { font-weight: 750; }
+
+.lp-al { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px;
+  background: color-mix(in srgb, var(--lens) 16%, var(--bg)); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--lens) 45%, transparent); color: var(--lens-text); }
+.lp-al b { font: 700 0.98rem/1.1 var(--font-body); }
+
+.lp-rem { display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 12px 14px; border-radius: 20px; text-align: left;
+  font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); cursor: pointer; }
+.lp-rem:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
