+.hg {
+  display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 't art' 'cta cta'; align-items: center; gap: 12px 14px;
+  width: 100%; padding: 16px 16px 14px 18px; border: 0; border-radius: 24px; text-align: left; cursor: pointer;
+  background: var(--go-bg); color: var(--go-ink); box-shadow: var(--go-glow);
+}
+.hg:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
+.hg .t { grid-area: t; display: grid; gap: 4px; min-width: 0; }
+.hg .t small { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; font: 700 0.82rem/1.1 var(--font-body); color: color-mix(in srgb, var(--go-ink) 84%, transparent); }
+.hg .t b { font: 700 1.2rem/1.18 var(--font-display); letter-spacing: -0.01em; text-wrap: balance; }
+.hg .t .s { font: 500 0.9rem/1.3 var(--font-body); color: color-mix(in srgb, var(--go-ink) 90%, transparent); text-wrap: balance; }
+.hg-tag { font: 650 0.72rem/1 var(--font-body); font-style: normal; padding: 3px 8px; border-radius: 999px; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--go-ink) 55%, transparent); color: var(--go-ink); }
+.hg-art { grid-area: art; width: 54px; height: 54px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--go-art); color: var(--go-art-ink); }
+.hg-cta {
+  grid-area: cta; display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 16px;
+  font: 750 1.05rem/1 var(--font-body); letter-spacing: 0.01em; color: var(--go-cta-ink); background: var(--go-cta);
+}
+.hg-cta .gl { display: none; }
+/* Akşam ya da serbest gün: Dalga sakin bir seçenek (degrade iş düğmesi değil); üstünde koyu, durgun dalga görseli
+   (Yön A'dan aşı). Görselin zemini gece rengidir, her temada koyu (dalga çizgileri iris tokenlarından). */
+.hg.calm {
+  grid-template-areas: 'art art' 't cta'; gap: 12px; padding: 10px 12px 12px;
+  background: var(--surface); color: var(--ink); border: 1px solid var(--border); box-shadow: var(--shadow);
+}
+.hg.calm .hg-art.wave {
+  width: 100%; height: 78px; border-radius: 16px; overflow: hidden;
+  background: radial-gradient(120% 150% at 30% 0%, color-mix(in srgb, var(--iris-1) 26%, #06131b) 0%, #07151d 52%, #050c12 100%);
+}
+.hg-wave { display: block; width: 100%; height: 100%; }
+.hg-wave path { fill: none; stroke-width: 2; stroke-linecap: round; }
+.hg-wave .w1 { stroke: var(--iris-1); opacity: 0.85; }
+.hg-wave .w2 { stroke: var(--iris-2); opacity: 0.75; }
+.hg-wave .w3 { stroke: #d6e6ee; opacity: 0.45; stroke-width: 1.5; }
+.hg-wave circle { fill: var(--iris-1); opacity: 0.55; }
+.hg.calm .t { padding-left: 6px; }
+.hg.calm .t b { font-size: 1.1rem; }
+.hg.calm .t .s { color: var(--ink-2); }
+.hg.calm .hg-cta { min-height: 46px; padding: 0 18px; background: var(--surface-2); color: var(--ink); box-shadow: none; }
+.hg.calm .hg-cta svg { color: var(--accent); }
+
+/* "Bugünün yolu" satırı: yol aşağıda; dokununca yola (bugünün yenisi varsa o durağa) iner */
+.hf-path {
+  display: flex; align-items: center; gap: 10px; width: 100%; min-height: 52px; padding: 4px 4px 4px 6px;
+  border: 0; border-radius: 16px; background: none; text-align: left; cursor: pointer; color: var(--ink);
+}
+.hf-path:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.hf-path .tx { display: grid; gap: 3px; flex: 1; min-width: 0; }
+.hf-path .tx b { font: 650 1rem/1.2 var(--font-display); letter-spacing: -0.005em; }
+.hf-path .tx span { display: inline-flex; align-items: center; gap: 5px; font: 500 0.9rem/1.25 var(--font-body); color: var(--ink-2); }
+.hf-path .tx span.ok { color: var(--ok); font-weight: 650; }
+.hf-path .pill { flex: none; font: 700 0.8rem/1 var(--font-body); padding: 6px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
+.hf-path .chev { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--border); color: var(--ink-2); }
+
+/* Dar ekran (320 pt) */
+@media (max-width: 360px) {
+  .hf .home-head h1 { font-size: 1.42rem; }
+  .hl-t { font-size: 1.36rem; }
+  .hl.long .hl-t { font-size: 1.12rem; }
+  .hg .t b { font-size: 1.06rem; }
+}
+/* Kısa ekran (≤ 740 pt: 320 × 640, iPhone SE): düğme tek satır; durağın çizimi ve "Başla" sağda tek sütun */
+@media (max-height: 740px) {
+  .hf { gap: 10px; }
+  .hf-hero-in { gap: 8px; }
+  .hi-legend { font-size: 0.86rem; }
+  .hl-t { font-size: 1.28rem; }
+  .hl.long .hl-t { font-size: 1.06rem; }
+  .hl-s { font-size: 0.9rem; }
+  .hl-list { font-size: 0.88rem; gap: 4px 6px; }
+  .hl-item { min-height: 28px; font-size: 0.86rem; padding: 3px 10px 3px 7px; }
+  .hg { grid-template-areas: 't cta'; gap: 10px; padding: 12px 12px 12px 16px; border-radius: 22px; }
+  .hg .t b { font-size: 1.04rem; }
+  .hg .t .s { font-size: 0.84rem; }
+  .hg-art { display: none; }
+  .hg-cta { flex-direction: column; gap: 4px; width: 66px; min-height: 70px; padding: 0; border-radius: 18px; font-size: 0.84rem; }
+  .hg-cta .gl { display: grid; }
+  .hg-cta .play { display: none; }
+  .hg.calm { grid-template-columns: 56px minmax(0, 1fr) auto; grid-template-areas: 'art t cta'; padding: 8px 8px 8px 8px; }
+  .hg.calm .hg-art.wave { display: block; width: 56px; height: 60px; border-radius: 14px; }
+  .hg.calm .t { padding-left: 0; }
+  .hg.calm .t .s { font-size: 0.84rem; }
+  .hg.calm .hg-cta { width: 60px; min-height: 60px; background: var(--surface-2); color: var(--ink); }
+  .hf-path { min-height: 48px; }
+}
+
+/* ---- Tur 5 (sahibin kararı 2026-10-01): ilk 7 gün iris yok, yol öne gelir ----
+   .hf.wk1: sahne ekran boyu değil; büyük düğmenin hemen altından yol başlar (Home.jsx yolEl). */
+.hf.wk1 { min-height: 0; padding-bottom: 4px; }
+.hf.wk1 .hf-hero { flex: none; }
+.hf.wk1 .hf-hero-in { padding-top: 6px; }
+.hf.wk1 .hl { align-self: stretch; }
+
+/* ---- Hava satırı (components/SkyLine.jsx; B2 tasarımı tpl-home). 320 pt'de il adı düşer, ilçe kısalmaz. ---- */
+.wxc { --wx-rain: #2f6bea; display: grid; gap: 8px; padding: 12px 14px; border-radius: 22px; border: 1px solid var(--border);
+  background: linear-gradient(160deg, rgba(47, 107, 234, 0.12), rgba(17, 169, 184, 0.06)), var(--surface); }
+@media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .wxc { --wx-rain: #6f9bff; } }
+:root[data-theme='dark'] .wxc { --wx-rain: #6f9bff; }
+.wxc-main { display: grid; gap: 8px; width: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; border-radius: 14px; }
+.wxc-main:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+.wxc-top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; min-height: 44px; }
+.wxc-deg { font: 800 2.4rem/0.9 var(--font-display); letter-spacing: -0.03em; }
+.wxc-tx { min-width: 0; display: grid; gap: 4px; }
+.wxc-tx b { font: 700 1rem/1.15 var(--font-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.wxc-tx .il { color: var(--ink-2); font-weight: 600; }
+.wxc-tx .rain { font: 600 0.88rem/1.25 var(--font-body); color: var(--wx-rain); }
+.wxc-ic { color: var(--ink-2); }
+.wxc-ic.r { color: var(--wx-rain); }
+.wxc-bars { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; align-items: end; height: 30px; }
+.wxc-bars i { display: block; border-radius: 3px; background: var(--surface-3); min-height: 3px; }
+.wxc-bars i.r { background: var(--wx-rain); }
+.wxc-ax { display: flex; justify-content: space-between; font: 500 0.7rem/1 var(--font-body); font-variant-numeric: tabular-nums; color: var(--ink-3); }
+.wxc-attr { display: flex; justify-content: space-between; align-items: center; min-height: 24px; font: 600 0.74rem/1 var(--font-body); color: var(--ink-3); }
+.wxc-attr a { display: inline-flex; align-items: center; min-height: 44px; margin: -10px 0; color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
+@media (max-width: 359px) {
+  .wxc-tx .il { display: none; }
+  .wxc-deg { font-size: 2rem; }
+}
