+/* ---- Ana sayfa 5 saniye yeniden tasarımı (2026-09-30): Yön B "Senin gözün" ve beş değerlendiricinin aşıları ----
+   İlk görünüm ekran boyunda tek sahnedir (.hf): selam, kişinin gözü (her gün bir ışın; components/home/DayIris.jsx),
+   günün tek cümlesi, tek büyük düğme, "Bugünün yolu" satırı. Sahne en az ekran boyudur: ardından gelen her şey ekranın
+   altından başlar, sahnenin son satırı sekme çubuğunun 12 pt üstünde biter (çubuğun ardına yazı sızmaz). Gözün boyu
+   (--iris) Home.jsx'te sahneye sığdırılır; buradaki değer ilk çizim içindir. Renkler tokenlardan; göz bebeği her temada
+   siyah olduğu için bebeğin yazısı sabit açık renktir (koyu temanın ink tokenlarının değerleri). */
+.hf {
+  --tabbar-h: 70px;
+  --iris: clamp(150px, min(100vw - 72px, 100svh - 540px), 320px);
+  position: relative; display: flex; flex-direction: column; gap: 12px;
+  min-height: calc(100vh - 20px - env(safe-area-inset-top));
+  min-height: calc(100svh - 20px - env(safe-area-inset-top));
+  padding-bottom: calc(var(--tabbar-h) + 12px + env(safe-area-inset-bottom));
+}
+.hf .nw { white-space: nowrap; }
+.hf-alert { margin: 0; }
+.hf-hero { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; min-height: 0; overflow-x: clip; }
+.hf-hero-in { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 2px 0 4px; }
+.hf-yol { display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 12px; }
+
+/* Senin gözün */
+.hi { display: flex; flex-direction: column; align-items: center; gap: 2px; width: 100%; }
+.hi-today { display: inline-flex; align-items: center; gap: 4px; height: 18px; font: 700 0.84rem/1 var(--font-body); letter-spacing: 0.01em; color: var(--accent); }
+.hi-today.done { color: var(--ok); }
+.hi-eye { display: block; padding: 0; border: 0; background: none; color: inherit; cursor: pointer; border-radius: 50%; }
+.hi-eye:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
+.hi-disc { position: relative; display: block; width: var(--iris); height: var(--iris); }
+.hi-disc::before { /* gözün yumuşak ışık halesi (iris renkleri) */
+  content: ''; position: absolute; inset: -8%; border-radius: 50%; pointer-events: none;
+  background: radial-gradient(circle, color-mix(in srgb, var(--iris-1) 18%, transparent) 0%, color-mix(in srgb, var(--iris-2) 7%, transparent) 42%, transparent 66%);
+}
+.hi-disc.seed::before { opacity: 0.6; }
+.hi-disc canvas { position: relative; display: block; width: 100%; height: 100%; }
+@media (prefers-reduced-motion: no-preference) {
+  .hi-disc canvas { animation: hi-in 0.6s ease-out both; }
+  @keyframes hi-in { from { opacity: 0; transform: scale(0.97); } }
+}
+.hi-pupil {
