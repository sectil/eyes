{"abstract":[{"text":"A view that reports the user’s application, category, and web domain activity in a privacy-preserving way.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity\/DeviceActivityReport"},"kind":"symbol","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"availableLanguages":["de-DE","en-US","es-419","fr-FR","it-IT","ja-JP","ko-KR","pt-BR","zh-CN"],"externalID":"s:23_DeviceActivity_SwiftUI0aB6ReportV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeviceActivityReport"}],"modules":[{"name":"DeviceActivity","relatedModules":["SwiftUI"]}],"navigatorTitle":[{"kind":"identifier","text":"DeviceActivityReport"}],"platforms":[{"beta":false,"deprecated":false,"introducedAt":"16.0","name":"iOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"16.0","name":"iPadOS","unavailable":false},{"beta":false,"deprecated":false,"introducedAt":"16.0","name":"Mac Catalyst","unavailable":false}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"DeviceActivityReport"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"attribute","text":"@"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/MainActor","kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"attribute","text":"@preconcurrency"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeviceActivityReport"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"When you create a report, the system asks your app’s device activity report extension to provide a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/View","isActive":true,"type":"reference"},{"text":" representing the user’s device activity. To protect the","type":"text"},{"text":" ","type":"text"},{"text":"user’s privacy, your extension runs in a sandbox. This sandbox prevents your extension from making network requests or moving","type":"text"},{"text":" ","type":"text"},{"text":"sensitive content outside the extension’s address space. The extension point identifier for all device activity report extensions is","type":"text"},{"text":" ","type":"text"},{"code":"com.apple.deviceactivityui.report-extension","type":"codeVoice"},{"text":". You can configure a report with a custom context and filter, and","type":"text"},{"text":" ","type":"text"},{"text":"then display the report like any SwiftUI view.","type":"text"}],"type":"paragraph"},{"code":["struct ExampleView: View {","    let selectedApps: Set<ApplicationToken>","    let selectedCategories: Set<ActivityCategoryToken>","    let selectedWebDomains: Set<WebDomainToken>","","    @State private var context: DeviceActivityReport.Context = .barGraph","    @State private var filter = DeviceActivityFilter(","        segment: .daily(","            during: Calendar.current.dateInterval(","               of: .weekOfYear, for: .now","            )!","        ),","        users: .children,","        devices: .init([.iPhone, .iPad]),","        applications: selectedApps,","        categories: selectedCategories,","        webDomains: selectedWebDomains","    )","","    public var body: some View {","        VStack {","            DeviceActivityReport(context, filter: filter)","","            \/\/ A picker used to change the report's context.","            Picker(selection: $context, label: Text(\"Context: \")) {","                Text(\"Bar Graph\")","                    .tag(DeviceActivityReport.Context.barGraph)","                Text(\"Pie Chart\")","                     .tag(DeviceActivityReport.Context.pieChart)","            }","","            \/\/ A picker used to change the filter's segment interval.","            Picker(","                selection: $filter.segmentInterval,","                 label: Text(\"Segment Interval: \")","            ) {","                Text(\"Hourly\")","                    .tag(DeviceActivityFilter.SegmentInterval.hourly())","                Text(\"Daily\")","                    .tag(DeviceActivityFilter.SegmentInterval.daily(","                        during: Calendar.current.dateInterval(","                             of: .weekOfYear, for: .now","                        )!","                    ))","                Text(\"Weekly\")","                    .tag(DeviceActivityFilter.SegmentInterval.weekly(","                        during: Calendar.current.dateInterval(","                            of: .month, for: .now","                        )!","                    ))","            }","            \/\/ ...","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The system will only provide your extension with device activity data if the user has authorized your app for family","type":"text"},{"text":" ","type":"text"},{"text":"controls on their device or on the device(s) of children in their iCloud family. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/FamilyControls\/AuthorizationCenter","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"for more details.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.documentation\/documentation\/Swift\/Sendable","doc:\/\/com.apple.documentation\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/View"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Report-activity","generated":true,"identifiers":["doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity\/DeviceActivityReportExtension","doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity\/DeviceActivityReportScene","doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity\/DeviceActivityReportBuilder"],"title":"Report activity"}],"topicSections":[{"anchor":"Structures","generated":true,"identifiers":["doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity\/DeviceActivityReport\/Context"],"title":"Structures"},{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity\/DeviceActivityReport\/init(_:filter:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity\/DeviceActivityReport\/body"],"title":"Instance Properties"}],"variants":[{"paths":["\/documentation\/deviceactivity\/deviceactivityreport"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.DeviceActivity/documentation/DeviceActivity":{"abstract":[{"text":"Monitor device activity with your app extension while maintaining privacy.","type":"text"}],"identifier":"doc:\/\/com.apple.DeviceActivity\/documentation\/DeviceActivity","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Device Activity"}],"role":"collection","title":"Device Activity","type":"topic","url":"\/documentation\/deviceactivity"},"doc://com.apple.DeviceActivity/documentation/DeviceActivity/DeviceActivityReport":{"abstract":[{"text":"A view that reports the user’s application, category, and web domain activity in a privacy-